{
  "identifier": "main",
  "description": "Scoped local commands for the Picaso main window.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-installation-info",
    "allow-credential-status",
    "allow-select-source",
    "allow-save-key",
    "allow-remove-key",
    "allow-open-key-portal",
    "allow-history",
    "allow-current-model",
    "allow-available-models",
    "allow-submit-job",
    "allow-export-image"
  ]
}
