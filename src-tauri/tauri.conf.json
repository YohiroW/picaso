{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Picaso",
  "version": "0.1.0",
  "identifier": "app.picaso.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Picaso", "width": 640, "height": 430, "minWidth": 360, "minHeight": 330 }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.png", "icons/icon.icns"],
    "category": "GraphicsAndDesign",
    "macOS": { "minimumSystemVersion": "14.0", "signingIdentity": "-" }
  }
}
