{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Picaso",
  "version": "0.1.1",
  "identifier": "app.picaso.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Picaso",
        "width": 1060,
        "height": 760,
        "minWidth": 380,
        "minHeight": 460
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: picaso-image: http://picaso-image.localhost; style-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "category": "GraphicsAndDesign",
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-"
    }
  }
}
